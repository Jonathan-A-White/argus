# A.R.G.U.S. runs on BSV TESTNET only. There is no mainnet mode.
#
# embedded-testnet (the default when unset) is the real app: every person
# creates their own device key, the unit's data is encrypted and shared on BSV testnet, and
# devices find each other's records through WhatsOnChain (api.whatsonchain.com).
#
# mock-development runs a single-device demo with a mock identity and no network. It is refused
# in production builds.
VITE_ARGUS_BLOCKCHAIN_MODE=embedded-testnet

# Never place wallet keys, seeds, passphrases or API credentials in VITE_* variables: Vite embeds
# them in the public browser bundle. Device keys are created on each device and sealed under that
# person's passphrase.
