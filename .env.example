# Blockchain audit remains independently configurable. Shared device
# synchronization is mock/local-only until the BSV testnet chain transport lands.
#
# Accepted values: embedded-testnet, external-brc100-testnet, unconfigured,
# mock-development (mock-development is refused in a production build).
# `mainnet` is always refused; there is no mainnet mode.
VITE_ARGUS_BLOCKCHAIN_MODE=unconfigured

# The embedded wallet is always available in Settings. Selecting embedded-testnet
# or external-brc100-testnet targets testnet only; this setting never holds a
# key and mainnet is unavailable.

# Do not place wallet keys, mnemonics, seeds, signing secrets, or API credentials
# in VITE_* variables: Vite embeds them in the public browser bundle.
